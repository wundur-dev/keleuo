#!/bin/sh
# keleion [folder] [--new] [--ssh host:/path]
#
# Opens the Keleion session browser at a folder (this one when none is given), like
# `code .`. When a Keleion window is already open, the request goes to it instead of
# starting a second app. --new starts a session in the folder without the browser.
#
# Install (once): build the release binary, then link this script onto your PATH:
#   CARGO_TARGET_DIR="$HOME/Library/Caches/workbench-target" cargo build -p keleion-app --release
#   ln -s "<repo>/scripts/keleion" "$HOME/.local/bin/keleion"
# KELEION_BIN overrides where the binary is.

BIN="${KELEION_BIN:-${WORKBENCH_BIN:-$HOME/Library/Caches/workbench-target/release/keleion}}"
if [ ! -x "$BIN" ]; then
    echo "keleion: no binary at $BIN (build it first, see the top of this script)" >&2
    exit 1
fi
# Detached, so the terminal is free at once; the binary exits right away when it hands the
# request to an open window.
nohup "$BIN" "$@" >/dev/null 2>&1 &
