#!/bin/sh
# wundur [folder] [--new] [--ssh host:/path]
#
# Opens the Wundur session browser at a folder (this one when none is given), like
# `code .`. When a Wundur window is already open, the request goes to it instead of
# starting a second app. --new starts a session in the folder without the browser.
#
# Install (once): build the release binary, then link this script onto your PATH:
#   CARGO_TARGET_DIR="$HOME/Library/Caches/workbench-target" cargo build -p wundur-app --release
#   ln -s "<repo>/scripts/wundur" "$HOME/.local/bin/wundur"
# WUNDUR_BIN overrides where the binary is.

BIN="${WUNDUR_BIN:-${KELEUO_BIN:-${KELEION_BIN:-${WORKBENCH_BIN:-$HOME/Library/Caches/workbench-target/release/wundur}}}}"
if [ ! -x "$BIN" ]; then
    echo "wundur: no binary at $BIN (build it first, see the top of this script)" >&2
    exit 1
fi
# Detached, so the terminal is free at once; the binary exits right away when it hands the
# request to an open window.
nohup "$BIN" "$@" >/dev/null 2>&1 &
